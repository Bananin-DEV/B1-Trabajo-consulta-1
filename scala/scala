case class Repuesto(nombre: String, categoria: String, precio: Double, stock: Int)

val repuestos = List(
  Repuesto("Pastillas de Freno", "Frenos", 25.0, 15),
  Repuesto("Disco de Freno", "Frenos", 45.0, 8),
  Repuesto("Amortiguador Delantero", "Suspension", 65.0, 4),
  Repuesto("Espiral Trasero", "Suspension", 50.0, 6),
  Repuesto("Filtro de Aceite", "Motor", 8.0, 30),
  Repuesto("Filtro de Aire", "Motor", 12.0, 20),
  Repuesto("Bujia Iridium", "Motor", 10.0, 40),
  Repuesto("Kit de Embrague", "Transmision", 120.0, 3),
  Repuesto("Aceite 10W40", "Lubricantes", 28.0, 18),
  Repuesto("Refrigerante", "Refrigeracion", 15.0, 12)
)

// 1. Selección (filter): Repuestos con stock crítico menor a 5
val repuestosCriticos = repuestos.filter(_.stock < 5)

// 2. Transformación (map): Nombre en mayúsculas y precio con 15% IVA
val preciosFacturacion = repuestos.map(r => s"${r.nombre.toUpperCase} -> $$${r.precio * 1.15}")

// 3. Extremos (maxBy): Repuesto más costoso
val repuestoMasCaro = repuestos.maxBy(_.precio)

// 4. Acumulación (foldLeft): Valor monetario total del inventario
val totalInventario = repuestos.foldLeft(0.0)((acc, r) => acc + (r.precio * r.stock))
